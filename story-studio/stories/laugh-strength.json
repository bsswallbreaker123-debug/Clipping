{
  "id": "laugh-strength",
  "title": "What If You Got Stronger Every Time Someone Laughed At You?",
  "mood": "trend",
  "narrator": "am_michael",
  "stat": { "name": "Strength", "start": 100, "decimals": 0, "suffix": "%" },
  "cast": {
    "eli": { "name": "Eli", "voice": "am_puck", "hair": "spiky", "shirt": "#9aa5b1", "shirtStyle": "hoodie", "accessories": ["glasses"] },
    "tyler": { "name": "Tyler", "voice": "am_fenrir", "hair": "mohawk", "hairColor": "#1a1a1a", "shirt": "#22223b", "shirtStyle": "jacket", "accessories": ["chain"], "height": 1.1 },
    "nora": { "name": "Nora", "voice": "af_nicole", "hair": "bun", "hairColor": "#5c3d2e", "shirt": "#cdb4db", "accessories": ["earrings"] },
    "coach": { "name": "Coach Reed", "voice": "bm_george", "hair": "cap", "hairColor": "#d62828", "shirt": "#495057", "shirtStyle": "tee", "height": 1.12 },
    "mom": { "name": "Mom", "voice": "af_sarah", "hair": "long", "hairColor": "#3b2416", "shirt": "#52b788" },
    "max": { "name": "Max", "voice": "am_liam", "hair": "beanie", "hairColor": "#f77f00", "shirt": "#3a86ff" }
  },
  "parts": [
    {
      "part": 1,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Every time someone laughed at Eli, he got one percent stronger. And everyone laughed at Eli.", "chars": [{ "id": "eli", "x": 0.5, "expr": "nervous" }] },
        { "bg": "cafeteria", "label": "MONDAY", "crowd": 7, "camera": "wide", "vo": "Eli was the kid every school has. Glasses. Quiet. Easy target.", "chars": [{ "id": "eli", "x": 0.4, "expr": "neutral", "action": "walk", "to": 0.5 }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "wide", "vo": "And Tyler was the kid who made sure everybody knew it.", "chars": [{ "id": "eli", "x": 0.5, "expr": "neutral", "facing": "right" }, { "id": "tyler", "x": 0.7, "expr": "smug", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "punch", "vo": "One foot. One trip. Eli's lunch went everywhere.", "chars": [{ "id": "eli", "x": 0.55, "expr": "shocked", "action": "fall" }, { "id": "tyler", "x": 0.7, "expr": "grin", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Nice landing, four eyes! Ten out of ten!", "chars": [{ "id": "tyler", "x": 0.7, "expr": "grin", "action": "point", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "wide", "vo": "The whole cafeteria laughed. Two hundred people.", "chars": [{ "id": "eli", "x": 0.55, "expr": "crying", "action": "sit", "fx": ["tears"] }, { "id": "tyler", "x": 0.72, "expr": "grin", "action": "celebrate", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "shake", "transition": "flash", "vo": "And something inside Eli clicked.", "stat": { "delta": 200 }, "popup": { "title": "LAUGHTER ABSORBED", "lines": ["+200 LAUGHS", "STRENGTH +200%"], "style": "success" }, "chars": [{ "id": "eli", "x": 0.55, "expr": "shocked", "action": "sit", "glow": true }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "eli" }, "who": "eli", "vo": "Why do I feel... weird? Like I drank ten energy drinks.", "chars": [{ "id": "eli", "x": 0.55, "expr": "confused", "fx": ["question"] }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "wide", "vo": "He grabbed the table to stand up. The table came with him.", "chars": [{ "id": "eli", "x": 0.55, "expr": "shocked", "action": "celebrate" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "punch", "vo": "He dropped it. It cracked the floor.", "chars": [{ "id": "eli", "x": 0.55, "expr": "shocked", "fx": ["exclaim"] }, { "id": "tyler", "x": 0.75, "expr": "shocked", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Did you... did you just lift that with one hand?", "chars": [{ "id": "tyler", "x": 0.72, "expr": "confused", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "eli" }, "who": "eli", "vo": "No! It's, uh... a really light table. Made of plastic. Bye!", "chars": [{ "id": "eli", "x": 0.55, "expr": "cringe", "action": "exit-left", "fx": ["sweat"] }] },
        { "bg": "bedroom", "label": "THAT NIGHT", "time": "night", "transition": "fade", "camera": "slowzoom", "vo": "That night, Eli ran some tests.", "chars": [{ "id": "eli", "x": 0.45, "expr": "determined" }] },
        { "bg": "bedroom", "time": "night", "camera": "wide", "vo": "Push-ups. Before today, his record was four. Tonight, he stopped at three hundred because he got bored.", "chars": [{ "id": "eli", "x": 0.45, "expr": "smug", "action": "jump" }] },
        { "bg": "bedroom", "time": "night", "camera": { "focus": "eli" }, "who": "eli", "vo": "Every time they laugh at me, I get stronger. That's insane.", "chars": [{ "id": "eli", "x": 0.45, "expr": "grin", "fx": ["sparkle"] }] },
        { "bg": "bedroom", "time": "night", "camera": "wide", "who": "mom", "vo": "Eli! Dinner! And stop making so much noise up there!", "chars": [{ "id": "eli", "x": 0.4, "expr": "nervous", "facing": "right" }] },
        { "bg": "bedroom", "time": "night", "camera": "slowzoom", "vo": "He grabbed his phone to reply. He squeezed a tiny bit too hard.", "chars": [{ "id": "eli", "x": 0.4, "expr": "neutral", "action": "phone" }] },
        { "bg": "bedroom", "time": "night", "camera": "punch", "vo": "Crunch. His phone was now the size of a cookie.", "chars": [{ "id": "eli", "x": 0.4, "expr": "shocked", "action": "shake" }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "Eli was getting stronger. Much stronger. And tomorrow, he had gym class with Tyler.", "chars": [{ "id": "eli", "x": 0.5, "expr": "smug", "glow": true }] }
      ]
    },
    {
      "part": 2,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli gets stronger every time someone laughs at him. Today, he has gym class with his bully.", "chars": [{ "id": "eli", "x": 0.4, "expr": "smug" }, { "id": "tyler", "x": 0.6, "expr": "angry" }] },
        { "bg": "gym", "label": "GYM CLASS", "crowd": 6, "camera": "wide", "who": "coach", "vo": "Alright, today we test max bench press! Eli, you're up first!", "chars": [{ "id": "coach", "x": 0.68, "expr": "determined", "facing": "left" }, { "id": "eli", "x": 0.35, "expr": "nervous", "facing": "right" }] },
        { "bg": "gym", "crowd": 6, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "This is gonna be hilarious. Somebody film this!", "chars": [{ "id": "tyler", "x": 0.6, "expr": "grin", "action": "phone" }] },
        { "bg": "gym", "crowd": 6, "camera": "wide", "vo": "Everyone laughed before he even touched the bar. Eli smiled.", "stat": { "delta": 30 }, "chars": [{ "id": "eli", "x": 0.4, "expr": "smug" }, { "id": "tyler", "x": 0.65, "expr": "grin", "facing": "left" }] },
        { "bg": "gym", "crowd": 6, "camera": { "focus": "eli" }, "who": "eli", "vo": "Coach... can you put more weight on? Like, all of it?", "chars": [{ "id": "eli", "x": 0.4, "expr": "smug" }] },
        { "bg": "gym", "crowd": 6, "camera": "punch", "vo": "He lifted every weight in the gym. With one arm. While yawning.", "chars": [{ "id": "eli", "x": 0.45, "expr": "sleepy", "action": "celebrate", "glow": true }] },
        { "bg": "gym", "crowd": 6, "camera": "wide", "vo": "Nobody was laughing anymore.", "chars": [{ "id": "coach", "x": 0.72, "expr": "shocked", "facing": "left" }, { "id": "tyler", "x": 0.25, "expr": "shocked", "facing": "right" }] },
        { "bg": "gym", "crowd": 6, "camera": { "focus": "coach" }, "who": "coach", "vo": "Son... come see me after class.", "chars": [{ "id": "coach", "x": 0.7, "expr": "neutral", "facing": "left" }] },
        { "bg": "hallway", "label": "AFTER CLASS", "transition": "whip", "crowd": 5, "camera": "wide", "who": "nora", "vo": "Hey, Eli. That was really cool. Are you okay though? Your hand is bleeding.", "chars": [{ "id": "eli", "x": 0.38, "expr": "shocked", "facing": "right" }, { "id": "nora", "x": 0.64, "expr": "happy", "facing": "left" }] },
        { "bg": "hallway", "crowd": 5, "camera": { "focus": "eli" }, "vo": "Nora. The only person who never laughed at him. Ever.", "chars": [{ "id": "eli", "x": 0.38, "expr": "love", "facing": "right", "fx": ["blush"] }] },
        { "bg": "hallway", "crowd": 5, "camera": { "focus": "nora" }, "who": "nora", "vo": "Here. I always carry band-aids. Don't ask why.", "chars": [{ "id": "nora", "x": 0.62, "expr": "happy", "facing": "left" }] },
        { "bg": "hallway", "crowd": 5, "camera": "wide", "vo": "It was the best thirty seconds of his life. Then Tyler walked up.", "chars": [{ "id": "eli", "x": 0.38, "expr": "happy", "facing": "right" }, { "id": "nora", "x": 0.6, "expr": "happy", "facing": "left" }, { "id": "tyler", "x": 0.82, "action": "enter-right", "expr": "angry", "facing": "left" }] },
        { "bg": "hallway", "crowd": 5, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Think you're tough now? I don't know what steroids you're on, but it's over.", "chars": [{ "id": "tyler", "x": 0.75, "expr": "angry", "action": "point", "facing": "left" }] },
        { "bg": "hallway", "crowd": 5, "camera": "punch", "who": "tyler", "vo": "Friday. Three o'clock. Behind the school. You and me.", "chars": [{ "id": "eli", "x": 0.4, "expr": "nervous", "facing": "right" }, { "id": "tyler", "x": 0.68, "expr": "angry", "facing": "left", "fx": ["anger"] }] },
        { "bg": "hallway", "crowd": 5, "camera": { "focus": "eli" }, "vo": "Eli did the math. His strength was three hundred thirty percent. Tyler was a gym rat.", "chars": [{ "id": "eli", "x": 0.4, "expr": "nervous", "fx": ["sweat"] }] },
        { "bg": "bedroom", "time": "night", "label": "THAT NIGHT", "transition": "fade", "camera": { "focus": "eli" }, "who": "eli", "vo": "I need more laughs. A lot more. Before Friday.", "chars": [{ "id": "eli", "x": 0.45, "expr": "determined" }] },
        { "bg": "bedroom", "time": "night", "camera": "slowzoom", "vo": "So he made a plan. The most embarrassing plan in human history.", "chars": [{ "id": "eli", "x": 0.45, "expr": "grin", "action": "phone" }] },
        { "bg": "void", "transition": "flash", "camera": "punch", "vo": "He was going to make the whole internet laugh at him.", "chars": [{ "id": "eli", "x": 0.5, "expr": "grin", "glow": true }] }
      ]
    },
    {
      "part": 3,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli needs to get stronger before his fight on Friday. So he wants the whole internet to laugh at him.", "chars": [{ "id": "eli", "x": 0.5, "expr": "determined" }] },
        { "bg": "bedroom", "label": "WEDNESDAY", "camera": "wide", "who": "eli", "vo": "Hi internet. This is my dance. It's called the confused flamingo.", "chars": [{ "id": "eli", "x": 0.5, "expr": "cringe", "action": "wave" }] },
        { "bg": "bedroom", "camera": "shake", "vo": "It was the worst dance ever recorded. Arms everywhere. One sock missing.", "chars": [{ "id": "eli", "x": 0.5, "expr": "grin", "action": "jump" }] },
        { "bg": "bedroom", "vo": "He posted it. Then he waited.", "phone": { "app": "social", "title": "@eli.moves", "big": "214", "sub": "views" }, "chars": [{ "id": "eli", "x": 0.3, "expr": "nervous", "action": "phone" }] },
        { "bg": "bedroom", "camera": "slowzoom", "vo": "Ten minutes later.", "phone": { "app": "social", "title": "@eli.moves", "big": "1,400,000", "sub": "views - 'I CANT BREATHE 😭'" }, "chars": [{ "id": "eli", "x": 0.3, "expr": "shocked", "action": "phone" }] },
        { "bg": "bedroom", "camera": "shake", "transition": "flash", "vo": "One point four million people laughed at him at the same time.", "stat": { "delta": 9000 }, "popup": { "title": "LAUGHTER ABSORBED", "lines": ["+1,400,000 LAUGHS", "STRENGTH: 9,330%"], "style": "success" }, "chars": [{ "id": "eli", "x": 0.5, "expr": "shocked", "glow": true, "action": "shake" }] },
        { "bg": "bedroom", "camera": { "focus": "eli" }, "who": "eli", "vo": "Whoa. Whoa whoa whoa. Okay. This is a lot.", "chars": [{ "id": "eli", "x": 0.5, "expr": "shocked", "glow": true, "fx": ["sweat"] }] },
        { "bg": "bedroom", "camera": "punch", "vo": "He took one step. The floor cracked under his foot.", "chars": [{ "id": "eli", "x": 0.5, "expr": "nervous", "action": "walk", "to": 0.55 }] },
        { "bg": "school", "label": "THURSDAY", "transition": "whip", "crowd": 9, "camera": "wide", "vo": "At school, everyone had seen the video. Everyone.", "chars": [{ "id": "eli", "x": 0.45, "expr": "smug", "action": "walk", "to": 0.5 }] },
        { "bg": "school", "crowd": 9, "camera": "panleft", "who": "max", "vo": "Yo, it's the flamingo! Do the flamingo!", "chars": [{ "id": "max", "x": 0.3, "expr": "grin", "action": "point", "facing": "right" }, { "id": "eli", "x": 0.55, "expr": "grin", "facing": "left" }] },
        { "bg": "school", "crowd": 9, "camera": "wide", "vo": "So he did. And they laughed. And he got even stronger.", "stat": { "delta": 400 }, "chars": [{ "id": "eli", "x": 0.5, "expr": "grin", "action": "jump", "glow": true }] },
        { "bg": "school", "crowd": 9, "camera": { "focus": "nora" }, "who": "nora", "vo": "Eli... why are you doing this? People are laughing at you, not with you.", "chars": [{ "id": "eli", "x": 0.4, "expr": "neutral", "facing": "right" }, { "id": "nora", "x": 0.62, "expr": "sad", "facing": "left" }] },
        { "bg": "school", "crowd": 9, "camera": { "focus": "eli" }, "who": "eli", "vo": "I know what I'm doing, Nora. Trust me. It's worth it.", "chars": [{ "id": "eli", "x": 0.4, "expr": "smug", "facing": "right" }] },
        { "bg": "livingroom", "label": "THAT EVENING", "transition": "fade", "camera": "wide", "who": "mom", "vo": "Eli? Is that you? Come give your mom a hug.", "chars": [{ "id": "eli", "x": 0.35, "expr": "happy", "facing": "right" }, { "id": "mom", "x": 0.65, "expr": "happy", "facing": "left" }] },
        { "bg": "livingroom", "camera": "slowzoom", "vo": "He hugged her. Gently. As gently as he could.", "chars": [{ "id": "eli", "x": 0.45, "expr": "happy", "facing": "right" }, { "id": "mom", "x": 0.55, "expr": "happy", "facing": "left" }] },
        { "bg": "livingroom", "camera": "punch", "who": "mom", "vo": "Ow! Eli! You're hurting me!", "chars": [{ "id": "eli", "x": 0.45, "expr": "shocked", "facing": "right" }, { "id": "mom", "x": 0.58, "expr": "shocked", "facing": "left", "action": "shake" }] },
        { "bg": "livingroom", "camera": { "focus": "mom" }, "vo": "She stepped back, holding her arm. Looking at him like a stranger.", "chars": [{ "id": "mom", "x": 0.65, "expr": "sad", "facing": "left" }] },
        { "bg": "livingroom", "camera": { "focus": "mom" }, "who": "mom", "vo": "What's happening to you, Eli? Who are you becoming?", "chars": [{ "id": "mom", "x": 0.65, "expr": "crying", "facing": "left", "fx": ["tears"] }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "He was strong enough to win any fight. But he couldn't even hug his mom anymore.", "chars": [{ "id": "eli", "x": 0.5, "expr": "sad", "glow": true }] }
      ]
    },
    {
      "part": 4,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli is now ninety times stronger than a normal human. Today he fights his bully.", "chars": [{ "id": "eli", "x": 0.4, "expr": "determined", "glow": true }, { "id": "tyler", "x": 0.6, "expr": "angry" }] },
        { "bg": "school", "label": "FRIDAY, 3 PM", "crowd": 10, "camera": "wide", "vo": "The whole school showed up behind the gym. Phones out. Everyone filming.", "chars": [{ "id": "eli", "x": 0.35, "expr": "determined", "facing": "right" }, { "id": "tyler", "x": 0.66, "expr": "smug", "facing": "left" }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Look at this! The flamingo came to fight! Somebody call a vet!", "chars": [{ "id": "tyler", "x": 0.66, "expr": "grin", "action": "point", "facing": "left" }] },
        { "bg": "school", "crowd": 10, "camera": "wide", "vo": "Everybody laughed. Eli didn't even blink. More fuel.", "stat": { "delta": 300 }, "chars": [{ "id": "eli", "x": 0.35, "expr": "smug", "glow": true, "facing": "right" }] },
        { "bg": "school", "crowd": 10, "camera": "punch", "vo": "Tyler threw the first punch. Eli caught it. With two fingers.", "chars": [{ "id": "eli", "x": 0.45, "expr": "smug", "action": "point", "facing": "right" }, { "id": "tyler", "x": 0.58, "expr": "shocked", "facing": "left", "action": "shake" }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "What... what are you?", "chars": [{ "id": "tyler", "x": 0.58, "expr": "shocked", "facing": "left", "fx": ["sweat"] }] },
        { "bg": "school", "crowd": 10, "camera": "shake", "transition": "flash", "vo": "Eli flicked him. Just a flick. Tyler flew into the trash cans.", "chars": [{ "id": "eli", "x": 0.4, "expr": "smug", "facing": "right" }, { "id": "tyler", "x": 0.75, "expr": "shocked", "action": "fall", "fx": ["stars"] }] },
        { "bg": "school", "crowd": 10, "camera": "wide", "vo": "Silence. Then the whole school started laughing. But not at Eli.", "chars": [{ "id": "tyler", "x": 0.72, "expr": "crying", "action": "sit", "fx": ["tears"] }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "max" }, "who": "max", "vo": "Tyler got flicked into the garbage! By the flamingo!", "chars": [{ "id": "max", "x": 0.35, "expr": "grin", "action": "point" }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "eli" }, "who": "eli", "vo": "Not so funny when it's you, huh Tyler?", "chars": [{ "id": "eli", "x": 0.45, "expr": "smug", "glow": true }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "nora" }, "vo": "Nora was in the crowd. She wasn't laughing. She looked disappointed.", "chars": [{ "id": "nora", "x": 0.55, "expr": "sad" }] },
        { "bg": "school", "crowd": 10, "camera": "slowzoom", "vo": "Eli turned to leave. That was when he heard it. A low, strange sound.", "chars": [{ "id": "eli", "x": 0.4, "expr": "confused", "facing": "left", "fx": ["question"] }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "tyler" }, "vo": "Tyler was laughing. Sitting in the garbage. Laughing.", "chars": [{ "id": "tyler", "x": 0.7, "expr": "grin", "action": "sit" }] },
        { "bg": "school", "crowd": 10, "camera": "punch", "vo": "He stood up. And he lifted the dumpster over his head.", "chars": [{ "id": "tyler", "x": 0.7, "expr": "smug", "action": "celebrate", "glow": true }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "eli" }, "who": "eli", "vo": "No. No way. That's not possible.", "chars": [{ "id": "eli", "x": 0.4, "expr": "shocked", "fx": ["exclaim"] }] },
        { "bg": "school", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Funny thing, flamingo. The second they all laughed at me... I felt it too.", "chars": [{ "id": "tyler", "x": 0.68, "expr": "grin", "glow": true, "facing": "left" }] },
        { "bg": "void", "transition": "flash", "camera": "punch", "vo": "The power wasn't just Eli's. Anyone who got laughed at could get it.", "popup": { "title": "NEW HOST DETECTED", "lines": ["TYLER: 2,000%"], "style": "warning" }, "chars": [{ "id": "tyler", "x": 0.5, "expr": "smug", "glow": true }] },
        { "bg": "void", "camera": "slowzoom", "vo": "And Eli had just made the meanest guy in school a superhero.", "chars": [{ "id": "eli", "x": 0.5, "expr": "shocked" }] }
      ]
    },
    {
      "part": 5,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli humiliated his bully in front of the whole school. Now the bully has the same power.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "grin", "glow": true }] },
        { "bg": "school", "crowd": 9, "camera": "wide", "vo": "Tyler dropped the dumpster. The ground shook. Everyone ran.", "chars": [{ "id": "tyler", "x": 0.65, "expr": "smug", "glow": true, "facing": "left" }, { "id": "eli", "x": 0.35, "expr": "nervous", "facing": "right" }] },
        { "bg": "school", "crowd": 4, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Monday, flamingo. Rematch. And this time, I'm not holding back.", "chars": [{ "id": "tyler", "x": 0.65, "expr": "angry", "glow": true, "facing": "left" }] },
        { "bg": "gym", "label": "THAT EVENING", "transition": "whip", "camera": "wide", "who": "coach", "vo": "Sit down, Eli. I know exactly what's happening to you.", "chars": [{ "id": "eli", "x": 0.35, "expr": "nervous", "action": "sit", "facing": "right" }, { "id": "coach", "x": 0.66, "expr": "neutral", "facing": "left" }] },
        { "bg": "gym", "camera": { "focus": "eli" }, "who": "eli", "vo": "You do? How?", "chars": [{ "id": "eli", "x": 0.35, "expr": "confused", "action": "sit", "facing": "right" }] },
        { "bg": "void", "transition": "fade", "camera": "slowzoom", "who": "coach", "vo": "Nineteen ninety nine. I was the skinny kid everyone laughed at. Until I wasn't.", "chars": [{ "id": "coach", "x": 0.5, "expr": "sad", "glow": true }] },
        { "bg": "gym", "transition": "fade", "camera": { "focus": "coach" }, "who": "coach", "vo": "Here's what nobody tells you. That strength runs on anger. The more you use it, the angrier you get.", "chars": [{ "id": "coach", "x": 0.66, "expr": "determined", "facing": "left" }] },
        { "bg": "gym", "camera": { "focus": "coach" }, "who": "coach", "vo": "I hurt people, Eli. People I loved. That's why I became a coach. To make up for it.", "chars": [{ "id": "coach", "x": 0.66, "expr": "sad", "facing": "left" }] },
        { "bg": "gym", "camera": { "focus": "eli" }, "who": "eli", "vo": "So how do I beat Tyler on Monday?", "chars": [{ "id": "eli", "x": 0.35, "expr": "determined", "action": "sit", "facing": "right" }] },
        { "bg": "gym", "camera": { "focus": "coach" }, "who": "coach", "vo": "Wrong question, kid. The question is how you stop needing to.", "chars": [{ "id": "coach", "x": 0.66, "expr": "neutral", "facing": "left" }] },
        { "bg": "school", "label": "MONDAY", "transition": "whip", "crowd": 8, "camera": "panright", "vo": "Monday morning. Tyler had spent the whole weekend getting people to laugh at him on purpose.", "chars": [{ "id": "tyler", "x": 0.55, "expr": "grin", "glow": true }] },
        { "bg": "school", "crowd": 8, "camera": "wide", "vo": "He slipped on banana peels. He wore a clown nose. Twenty thousand percent.", "popup": { "title": "TYLER", "lines": ["STRENGTH: 20,000%"], "style": "warning" }, "chars": [{ "id": "tyler", "x": 0.55, "expr": "grin", "action": "celebrate", "glow": true }] },
        { "bg": "school", "crowd": 8, "camera": "punch", "vo": "And he was using it. He flipped Max's car. With Max sitting in it.", "chars": [{ "id": "tyler", "x": 0.6, "expr": "angry", "glow": true, "action": "celebrate" }, { "id": "max", "x": 0.35, "expr": "shocked", "fx": ["exclaim"] }] },
        { "bg": "school", "crowd": 8, "camera": { "focus": "eli" }, "vo": "Eli needed more power. Fast. He walked into the cafeteria and tripped on purpose.", "chars": [{ "id": "eli", "x": 0.45, "expr": "determined", "action": "fall" }] },
        { "bg": "cafeteria", "crowd": 7, "transition": "whip", "camera": "wide", "vo": "But nobody laughed. Not one person.", "chars": [{ "id": "eli", "x": 0.5, "expr": "confused", "action": "sit" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "max" }, "who": "max", "vo": "You okay, man? You're the guy who took down Tyler. Nobody's laughing at you anymore.", "chars": [{ "id": "max", "x": 0.6, "expr": "happy", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "punch", "vo": "They respected him now. And respect doesn't make you stronger.", "stat": { "set": 112 }, "popup": { "title": "STRENGTH FADING", "lines": ["9,930% → 112%"], "style": "warning" }, "chars": [{ "id": "eli", "x": 0.5, "expr": "shocked" }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "Eli was back to almost normal. And Tyler was at twenty thousand percent.", "chars": [{ "id": "eli", "x": 0.4, "expr": "nervous" }, { "id": "tyler", "x": 0.62, "expr": "grin", "glow": true }] }
      ]
    },
    {
      "part": 6,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli lost his power because people respect him now. And his bully is unstoppable.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "angry", "glow": true }] },
        { "bg": "school", "crowd": 6, "camera": "wide", "vo": "Over the next three days, Tyler took over the school.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "smug", "glow": true }] },
        { "bg": "cafeteria", "crowd": 6, "transition": "whip", "camera": "wide", "vo": "He took everyone's lunch. He took the principal's parking spot. He took the principal's car.", "chars": [{ "id": "tyler", "x": 0.55, "expr": "grin", "action": "celebrate", "glow": true }] },
        { "bg": "cafeteria", "crowd": 6, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "New rule. Every hour, you all laugh at me. Out loud. Or else.", "chars": [{ "id": "tyler", "x": 0.55, "expr": "angry", "action": "point", "glow": true }] },
        { "bg": "cafeteria", "crowd": 6, "camera": "slowzoom", "vo": "The whole school forced out a laugh. Tyler got stronger. And everyone got more scared.", "stat": { "delta": 0 }, "chars": [{ "id": "eli", "x": 0.3, "expr": "sad", "facing": "right" }, { "id": "tyler", "x": 0.6, "expr": "grin", "glow": true, "facing": "left" }] },
        { "bg": "park", "label": "AFTER SCHOOL", "transition": "fade", "camera": "wide", "who": "nora", "vo": "This is your fault, you know. You made him like this.", "chars": [{ "id": "eli", "x": 0.42, "expr": "sad", "action": "sit", "facing": "right" }, { "id": "nora", "x": 0.6, "expr": "angry", "action": "sit", "facing": "left" }] },
        { "bg": "park", "camera": { "focus": "eli" }, "who": "eli", "vo": "I know. I wanted everyone to laugh at him the way they laughed at me.", "chars": [{ "id": "eli", "x": 0.42, "expr": "sad", "action": "sit", "facing": "right" }] },
        { "bg": "park", "camera": { "focus": "nora" }, "who": "nora", "vo": "Then fix it. Not with fists. You were never the strong guy, Eli. You were the funny one.", "chars": [{ "id": "nora", "x": 0.6, "expr": "neutral", "action": "sit", "facing": "left" }] },
        { "bg": "park", "camera": { "focus": "eli" }, "who": "eli", "vo": "Funny? Nobody thinks I'm funny. They think I'm a joke.", "chars": [{ "id": "eli", "x": 0.42, "expr": "sad", "action": "sit", "facing": "right" }] },
        { "bg": "park", "camera": "slowzoom", "who": "nora", "vo": "I do. Your flamingo dance? I watched it forty times. Not because it was dumb. Because you looked happy.", "chars": [{ "id": "eli", "x": 0.42, "expr": "shocked", "action": "sit", "facing": "right" }, { "id": "nora", "x": 0.6, "expr": "happy", "action": "sit", "facing": "left", "fx": ["blush"] }] },
        { "bg": "park", "camera": "punch", "vo": "And then she laughed. A real laugh. Not at him. With him.", "chars": [{ "id": "nora", "x": 0.6, "expr": "grin", "action": "sit", "facing": "left" }, { "id": "eli", "x": 0.42, "expr": "happy", "action": "sit", "facing": "right" }] },
        { "bg": "park", "camera": "shake", "transition": "flash", "vo": "Something happened inside Eli. Something different. Warm.", "popup": { "title": "UNKNOWN ENERGY", "lines": ["SOURCE: SHARED LAUGHTER"], "color": "#ffd400" }, "chars": [{ "id": "eli", "x": 0.42, "expr": "shocked", "action": "sit", "glow": true }] },
        { "bg": "park", "camera": { "focus": "eli" }, "who": "eli", "vo": "Did you feel that? Do it again. Laugh again!", "chars": [{ "id": "eli", "x": 0.42, "expr": "grin", "action": "sit" }] },
        { "bg": "park", "camera": { "focus": "nora" }, "who": "nora", "vo": "I can't laugh on command, weirdo. Wait. Now I can.", "chars": [{ "id": "nora", "x": 0.6, "expr": "grin", "action": "sit", "facing": "left" }] },
        { "bg": "park", "camera": "slowzoom", "vo": "It wasn't much. But it felt stronger than anything he'd felt before.", "stat": { "delta": 20 }, "chars": [{ "id": "eli", "x": 0.42, "expr": "happy", "action": "sit", "fx": ["sparkle"] }] },
        { "bg": "park", "time": "evening", "camera": "wide", "vo": "Then both their phones buzzed at the same time.", "chars": [{ "id": "eli", "x": 0.42, "expr": "neutral", "action": "phone" }, { "id": "nora", "x": 0.6, "expr": "neutral", "action": "phone", "facing": "left" }] },
        { "bg": "park", "time": "evening", "vo": "A message to the entire school.", "phone": { "app": "chat", "title": "SCHOOL CHAT (1,204)", "messages": [{ "from": "them", "text": "TYLER: talent show friday" }, { "from": "them", "text": "TYLER: flamingo vs me. on stage. live" }, { "from": "them", "text": "TYLER: if he doesnt show i flatten his house" }] }, "chars": [{ "id": "eli", "x": 0.3, "expr": "shocked", "action": "phone" }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "Four days. A stage. The whole school watching. And a guy with twenty thousand percent strength.", "chars": [{ "id": "eli", "x": 0.5, "expr": "determined" }] }
      ]
    },
    {
      "part": 7,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli found a new power. Laughing with people, not at them. He has four days to master it.", "chars": [{ "id": "eli", "x": 0.5, "expr": "determined", "fx": ["sparkle"] }] },
        { "bg": "gym", "label": "TUESDAY", "camera": "wide", "who": "eli", "vo": "Coach. I need you to train me. But not for fighting.", "chars": [{ "id": "eli", "x": 0.35, "expr": "determined", "facing": "right" }, { "id": "coach", "x": 0.65, "expr": "smug", "facing": "left" }] },
        { "bg": "gym", "camera": { "focus": "coach" }, "who": "coach", "vo": "Shared laughter. Took me twenty years to figure that out. You did it in a week.", "chars": [{ "id": "coach", "x": 0.65, "expr": "happy", "facing": "left" }] },
        { "bg": "gym", "camera": { "focus": "coach" }, "who": "coach", "vo": "Laughing at someone makes you strong on the outside. Laughing with them makes you strong where it counts.", "chars": [{ "id": "coach", "x": 0.65, "expr": "neutral", "facing": "left" }] },
        { "bg": "cafeteria", "label": "TRAINING DAY 1", "transition": "whip", "crowd": 6, "camera": "wide", "vo": "Day one. Eli told a joke at lunch. On purpose. To make people laugh with him.", "chars": [{ "id": "eli", "x": 0.5, "expr": "nervous", "action": "talk" }] },
        { "bg": "cafeteria", "crowd": 6, "camera": "punch", "vo": "Nobody laughed. Total silence. A fork dropped somewhere.", "chars": [{ "id": "eli", "x": 0.5, "expr": "cringe", "fx": ["sweat"] }] },
        { "bg": "classroom", "label": "TRAINING DAY 2", "transition": "whip", "crowd": 5, "camera": "wide", "vo": "Day two. He stopped trying to be funny. He just told the truth.", "chars": [{ "id": "eli", "x": 0.5, "expr": "neutral", "action": "talk" }] },
        { "bg": "classroom", "crowd": 5, "camera": { "focus": "eli" }, "who": "eli", "vo": "I practiced my flamingo dance for six hours. My cat left the house. She hasn't come back.", "chars": [{ "id": "eli", "x": 0.5, "expr": "grin" }] },
        { "bg": "classroom", "crowd": 5, "camera": "wide", "vo": "The class burst out laughing. With him.", "stat": { "delta": 300 }, "chars": [{ "id": "eli", "x": 0.5, "expr": "happy", "fx": ["sparkle"] }, { "id": "max", "x": 0.75, "expr": "grin", "facing": "left" }] },
        { "bg": "classroom", "crowd": 5, "camera": "shake", "transition": "flash", "vo": "And the power came back. But different. Golden.", "popup": { "title": "GOLDEN STRENGTH", "lines": ["DOESN'T RUN ON ANGER"], "color": "#ffd400" }, "chars": [{ "id": "eli", "x": 0.5, "expr": "happy", "glow": true }] },
        { "bg": "livingroom", "label": "TRAINING DAY 3", "transition": "fade", "camera": "wide", "vo": "Day three. He went home and made his mom laugh until she cried.", "chars": [{ "id": "eli", "x": 0.38, "expr": "grin", "action": "talk", "facing": "right" }, { "id": "mom", "x": 0.62, "expr": "grin", "facing": "left", "fx": ["tears"] }] },
        { "bg": "livingroom", "camera": "slowzoom", "vo": "Then he hugged her. And this time, it didn't hurt.", "chars": [{ "id": "eli", "x": 0.45, "expr": "happy", "facing": "right", "glow": true }, { "id": "mom", "x": 0.55, "expr": "happy", "facing": "left" }] },
        { "bg": "livingroom", "camera": { "focus": "mom" }, "who": "mom", "vo": "There he is. There's my boy.", "chars": [{ "id": "mom", "x": 0.55, "expr": "crying", "facing": "left", "fx": ["tears"] }] },
        { "bg": "school", "label": "THURSDAY NIGHT", "time": "night", "transition": "whip", "crowd": 3, "camera": "wide", "vo": "The night before the show, Eli walked past the school. The lights were on in the gym.", "chars": [{ "id": "eli", "x": 0.35, "expr": "confused", "action": "walk", "to": 0.45 }] },
        { "bg": "gym", "time": "night", "camera": "slowzoom", "vo": "Tyler was inside. Alone. Practicing. But not for a fight.", "chars": [{ "id": "tyler", "x": 0.55, "expr": "sad", "action": "talk" }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Dad. I'm in the talent show tomorrow. You don't have to come. You never do.", "chars": [{ "id": "tyler", "x": 0.55, "expr": "crying", "fx": ["tears"] }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "eli" }, "vo": "Eli stood in the doorway. Frozen. Tyler wasn't practicing to fight. He was practicing to talk to his dad.", "chars": [{ "id": "eli", "x": 0.3, "expr": "shocked" }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "Then Tyler turned around. And saw him.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "angry", "glow": true }] }
      ]
    },
    {
      "part": 8,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli just saw his bully crying alone in the gym. And the bully saw him.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "angry", "glow": true }] },
        { "bg": "gym", "time": "night", "camera": "wide", "who": "tyler", "vo": "You didn't see anything. You hear me? Nothing!", "chars": [{ "id": "eli", "x": 0.3, "expr": "nervous", "facing": "right" }, { "id": "tyler", "x": 0.62, "expr": "angry", "glow": true, "facing": "left" }] },
        { "bg": "gym", "time": "night", "camera": "shake", "vo": "He punched the wall. It cracked from floor to ceiling.", "chars": [{ "id": "tyler", "x": 0.62, "expr": "angry", "glow": true, "action": "point", "facing": "left" }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "eli" }, "who": "eli", "vo": "Your dad laughs at you. Doesn't he?", "chars": [{ "id": "eli", "x": 0.3, "expr": "sad", "facing": "right" }] },
        { "bg": "gym", "time": "night", "camera": "slowzoom", "vo": "Tyler froze. The glow around him flickered.", "chars": [{ "id": "tyler", "x": 0.62, "expr": "shocked", "glow": true, "facing": "left" }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Every day. My grades. My clothes. My face. He laughs, and his friends laugh with him.", "chars": [{ "id": "tyler", "x": 0.62, "expr": "crying", "facing": "left", "fx": ["tears"] }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "tyler" }, "who": "tyler", "vo": "So I made sure someone at school had it worse than me. You.", "chars": [{ "id": "tyler", "x": 0.62, "expr": "sad", "facing": "left" }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "eli" }, "who": "eli", "vo": "That doesn't make it okay.", "chars": [{ "id": "eli", "x": 0.32, "expr": "determined", "facing": "right" }] },
        { "bg": "gym", "time": "night", "camera": { "focus": "tyler" }, "who": "tyler", "vo": "I know. That's why tomorrow, I'm going to win. In front of everyone. So he finally sees me.", "chars": [{ "id": "tyler", "x": 0.62, "expr": "determined", "glow": true, "facing": "left" }] },
        { "bg": "stage", "label": "TALENT SHOW", "transition": "whip", "crowd": 10, "camera": "wide", "vo": "Friday night. The gym was packed. Twelve hundred students. Phones everywhere.", "chars": [{ "id": "eli", "x": 0.35, "expr": "nervous", "facing": "right" }, { "id": "tyler", "x": 0.65, "expr": "determined", "glow": true, "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": "panleft", "vo": "And in the back row, in a gray suit, sat a man Eli had never seen. Tyler's dad.", "chars": [{ "id": "extra", "x": 0.55, "expr": "smug", "action": "sit" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Let's go, flamingo! Show them what you've got!", "chars": [{ "id": "tyler", "x": 0.65, "expr": "angry", "glow": true, "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": "shake", "transition": "flash", "vo": "Tyler charged. Eli dodged. The stage exploded into splinters.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "angry", "action": "run", "to": 0.3, "glow": true }, { "id": "eli", "x": 0.35, "expr": "shocked", "action": "jump" }] },
        { "bg": "stage", "crowd": 10, "camera": "punch", "vo": "Again. And again. Tyler was too fast. Too strong.", "chars": [{ "id": "eli", "x": 0.4, "expr": "crying", "action": "fall" }, { "id": "tyler", "x": 0.6, "expr": "angry", "glow": true, "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "eli" }, "vo": "Eli was on the floor. His glasses were cracked. And somewhere in the crowd, someone started laughing at him.", "chars": [{ "id": "eli", "x": 0.4, "expr": "sad", "action": "sit" }] },
        { "bg": "stage", "crowd": 10, "camera": "slowzoom", "vo": "It would be so easy. Let them laugh. Take the power. End it.", "popup": { "title": "LAUGHTER AVAILABLE", "lines": ["ABSORB? YES / NO"], "style": "warning" }, "chars": [{ "id": "eli", "x": 0.45, "expr": "angry", "action": "sit" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "nora" }, "who": "nora", "vo": "Eli! Not like that! Remember the flamingo!", "chars": [{ "id": "nora", "x": 0.6, "expr": "determined", "action": "wave" }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "Eli stood up. He took a deep breath. And he started to dance.", "chars": [{ "id": "eli", "x": 0.5, "expr": "grin", "action": "jump" }] }
      ]
    },
    {
      "part": 9,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "In the middle of a fight he was losing, Eli started doing the worst dance in history.", "chars": [{ "id": "eli", "x": 0.5, "expr": "grin", "action": "jump" }] },
        { "bg": "stage", "crowd": 10, "camera": "wide", "vo": "The confused flamingo. Live. On a broken stage. In front of twelve hundred people.", "chars": [{ "id": "eli", "x": 0.45, "expr": "grin", "action": "jump" }, { "id": "tyler", "x": 0.7, "expr": "confused", "facing": "left", "glow": true }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "What are you doing?! Fight me!", "chars": [{ "id": "tyler", "x": 0.7, "expr": "angry", "glow": true, "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "eli" }, "who": "eli", "vo": "Nope. Flamingos don't fight. Flamingos dance. Come on, everybody!", "chars": [{ "id": "eli", "x": 0.45, "expr": "grin", "action": "wave" }] },
        { "bg": "stage", "crowd": 10, "camera": "wide", "vo": "Nora jumped on stage first. Then Max. Then Coach Reed, very badly.", "chars": [{ "id": "nora", "x": 0.3, "expr": "grin", "action": "jump" }, { "id": "eli", "x": 0.48, "expr": "grin", "action": "jump" }, { "id": "max", "x": 0.64, "expr": "grin", "action": "celebrate" }, { "id": "coach", "x": 0.8, "expr": "cringe", "action": "jump" }] },
        { "bg": "stage", "crowd": 10, "camera": "panleft", "vo": "And the whole gym started laughing. Not at anyone. Together.", "stat": { "delta": 50000 }, "chars": [{ "id": "eli", "x": 0.45, "expr": "happy", "action": "celebrate", "glow": true }] },
        { "bg": "stage", "crowd": 10, "camera": "shake", "transition": "flash", "vo": "The golden power hit Eli like a wave.", "popup": { "title": "GOLDEN STRENGTH", "lines": ["50,000%"], "color": "#ffd400" }, "chars": [{ "id": "eli", "x": 0.45, "expr": "happy", "glow": true, "fx": ["sparkle"] }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "tyler" }, "vo": "But Tyler felt something else. His power was draining. Nobody was laughing at him anymore.", "chars": [{ "id": "tyler", "x": 0.7, "expr": "shocked", "facing": "left", "fade": 0.1 }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "No. No! Laugh at me! Somebody laugh at me!", "chars": [{ "id": "tyler", "x": 0.7, "expr": "crying", "facing": "left", "fx": ["tears"] }] },
        { "bg": "stage", "crowd": 10, "camera": "punch", "vo": "Tyler ran at Eli with everything he had left. One last punch.", "chars": [{ "id": "tyler", "x": 0.65, "expr": "angry", "action": "run", "to": 0.52 }, { "id": "eli", "x": 0.4, "expr": "determined", "glow": true, "facing": "right" }] },
        { "bg": "stage", "crowd": 10, "camera": "slowzoom", "vo": "Eli could have ended it. Fifty thousand percent. One hit.", "chars": [{ "id": "eli", "x": 0.42, "expr": "determined", "glow": true, "facing": "right" }, { "id": "tyler", "x": 0.55, "expr": "angry", "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "eli" }, "vo": "Instead, he opened his arms.", "chars": [{ "id": "eli", "x": 0.45, "expr": "happy", "action": "shrug", "glow": true, "facing": "right" }] },
        { "bg": "stage", "crowd": 10, "camera": "shake", "transition": "flash", "vo": "Tyler crashed into him. And Eli hugged him. Gently.", "chars": [{ "id": "eli", "x": 0.46, "expr": "happy", "facing": "right", "glow": true }, { "id": "tyler", "x": 0.55, "expr": "shocked", "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Why? Why aren't you hitting me?", "chars": [{ "id": "tyler", "x": 0.55, "expr": "crying", "facing": "left", "fx": ["tears"] }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "eli" }, "who": "eli", "vo": "Because you don't need someone to hit you. You need someone to see you.", "chars": [{ "id": "eli", "x": 0.46, "expr": "happy", "facing": "right" }] },
        { "bg": "stage", "crowd": 10, "camera": "wide", "vo": "The gym went silent. Then someone in the back row stood up.", "chars": [{ "id": "extra", "x": 0.6, "expr": "neutral" }] },
        { "bg": "stage", "crowd": 10, "camera": "punch", "vo": "Tyler's dad. Walking toward the stage. And he wasn't laughing.", "chars": [{ "id": "extra", "x": 0.7, "action": "walk", "to": 0.6 }, { "id": "tyler", "x": 0.4, "expr": "shocked" }] },
        { "bg": "void", "transition": "flash", "camera": "slowzoom", "vo": "For the first time in his life, Tyler had no idea what his dad was going to say.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "nervous", "fx": ["sweat"] }] }
      ]
    },
    {
      "part": 10,
      "shots": [
        { "bg": "void", "camera": "punch", "transition": "flash", "vo": "Eli chose a hug over a punch. Now Tyler's dad is walking onto the stage.", "chars": [{ "id": "tyler", "x": 0.5, "expr": "nervous" }] },
        { "bg": "stage", "crowd": 10, "camera": "wide", "vo": "His dad stopped in front of him. The whole school held its breath.", "chars": [{ "id": "tyler", "x": 0.42, "expr": "nervous", "facing": "right" }, { "id": "extra", "x": 0.62, "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": "slowzoom", "vo": "He said three words. Nobody else heard them. But Tyler started crying.", "chars": [{ "id": "tyler", "x": 0.42, "expr": "crying", "facing": "right", "fx": ["tears"] }, { "id": "extra", "x": 0.58, "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "He said, I'm sorry, son. He's never said that. Not once.", "chars": [{ "id": "tyler", "x": 0.45, "expr": "happy", "fx": ["tears"] }] },
        { "bg": "stage", "crowd": 10, "camera": "shake", "transition": "flash", "vo": "And just like that, the power left them both. Tyler. Eli. Gone.", "stat": { "set": 100 }, "popup": { "title": "POWER RELEASED", "lines": ["STRENGTH: 100%"], "style": "system" }, "chars": [{ "id": "eli", "x": 0.4, "expr": "shocked" }, { "id": "tyler", "x": 0.6, "expr": "shocked", "facing": "left" }] },
        { "bg": "stage", "crowd": 10, "camera": { "focus": "eli" }, "who": "eli", "vo": "It's gone. I'm normal again.", "chars": [{ "id": "eli", "x": 0.42, "expr": "neutral" }] },
        { "bg": "gym", "label": "AFTERWARDS", "transition": "fade", "camera": "wide", "who": "coach", "vo": "It leaves when you stop needing it. Took me twenty years. Took you two weeks.", "chars": [{ "id": "eli", "x": 0.35, "expr": "happy", "facing": "right" }, { "id": "coach", "x": 0.65, "expr": "happy", "facing": "left" }] },
        { "bg": "cafeteria", "label": "ONE MONTH LATER", "transition": "whip", "crowd": 7, "camera": "wide", "vo": "One month later. Same cafeteria. Same table.", "chars": [{ "id": "eli", "x": 0.35, "expr": "happy", "action": "sit", "facing": "right" }, { "id": "nora", "x": 0.52, "expr": "happy", "action": "sit", "facing": "left" }, { "id": "tyler", "x": 0.7, "expr": "happy", "action": "sit", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "tyler" }, "who": "tyler", "vo": "Okay flamingo, I have a confession. I practiced your dance. My dad helped.", "chars": [{ "id": "tyler", "x": 0.7, "expr": "cringe", "action": "sit", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "wide", "vo": "The whole table laughed. With him.", "chars": [{ "id": "eli", "x": 0.35, "expr": "grin", "action": "sit", "facing": "right" }, { "id": "nora", "x": 0.52, "expr": "grin", "action": "sit", "facing": "left" }, { "id": "tyler", "x": 0.7, "expr": "grin", "action": "sit", "facing": "left" }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "nora" }, "who": "nora", "vo": "So, Eli. Movie on Saturday? You pick. As long as there's no dancing.", "chars": [{ "id": "nora", "x": 0.52, "expr": "love", "action": "sit", "facing": "left", "fx": ["blush"] }] },
        { "bg": "cafeteria", "crowd": 7, "camera": { "focus": "eli" }, "who": "eli", "vo": "No promises.", "chars": [{ "id": "eli", "x": 0.35, "expr": "love", "action": "sit", "facing": "right", "fx": ["hearts"] }] },
        { "bg": "cafeteria", "crowd": 7, "camera": "panright", "vo": "No one at that school got laughed at that year. Not once.", "chars": [{ "id": "max", "x": 0.6, "expr": "happy", "action": "wave" }] },
        { "bg": "park", "label": "ACROSS TOWN", "transition": "whip", "crowd": 4, "camera": "wide", "vo": "But across town, at a different school, a small kid tripped in front of everyone.", "chars": [{ "id": "extra", "x": 0.5, "scale": 0.8, "action": "fall" }] },
        { "bg": "park", "crowd": 4, "camera": "slowzoom", "vo": "Everybody laughed. And the kid's eyes started to glow.", "popup": { "title": "LAUGHTER ABSORBED", "lines": ["NEW HOST: +1%"], "style": "warning" }, "chars": [{ "id": "extra", "x": 0.5, "scale": 0.8, "glow": true, "action": "sit" }] },
        { "bg": "void", "transition": "flash", "camera": "punch", "vo": "Somebody is going to have to teach that kid the difference. Would you laugh with him, or at him?", "chars": [{ "id": "eli", "x": 0.5, "expr": "smug" }] }
      ]
    }
  ]
}
